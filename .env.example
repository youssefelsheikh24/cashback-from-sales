# ─────────────────────────────────────────────────────────────
# CashBack Sales & Production Request — Cloudflare Pages + Supabase
# Copy to ".env" (local) and set the same vars in the Cloudflare Pages
# dashboard (Settings → Environment variables) for production.
# NEVER commit the real .env. All of these are server-only secrets.
# ─────────────────────────────────────────────────────────────

# ── Database: Supabase Postgres, fronted by Prisma Accelerate ────
# WHY Accelerate: Cloudflare's edge runtime can't run Prisma's TCP/`pg` driver
# (it needs Node net/fs). Accelerate exposes the SAME Supabase database over
# HTTPS so Prisma runs on the edge. Supabase is still the database of record.
#
# Runtime (edge) — Accelerate connection string.
#   Prisma Console → your project → Accelerate → enable, paste the Supabase
#   DIRECT_URL below as the underlying DB, then copy the prisma:// URL here.
DATABASE_URL="prisma://accelerate.prisma-data.net/?api_key=<accelerate-api-key>"

# Migrations only — Supabase "Direct connection", port 5432.
#   Used by `prisma db push` / `prisma migrate` (run LOCALLY, never on edge)
#   and by Accelerate as the real database. Enables the isolated schema too.
DIRECT_URL="postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres"

# ── Supabase Storage + client (uploads/downloads) ────────────
SUPABASE_URL="https://<project-ref>.supabase.co"
# service_role key — Project Settings → API → service_role. SERVER ONLY. Never NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
# A NEW, dedicated PRIVATE bucket (create it in Supabase → Storage). See README.
SUPABASE_STORAGE_BUCKET="cashback-sales-refs"

# ── Auth (JWT session cookie) ────────────────────────────────
# Signs the Sales session JWT. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-secret"

# ── Seed Sales account (used by "npm run db:seed") ───────────
ADMIN_EMAIL="sales@cashback.agency"
ADMIN_PASSWORD="CashBack2026!"
ADMIN_NAME="CashBack Sales"

# ── Email: Resend (HTTP API — edge compatible) ───────────────
# Leave RESEND_API_KEY blank to run in "dev mode": the notification is logged
# to the console and the app reports emailSent:false (no fake sends).
RESEND_API_KEY=""
RESEND_FROM="CashBack Production <onboarding@resend.dev>"
# Where NEW PRODUCTION REQUEST emails are delivered.
ADMIN_NOTIFICATION_EMAIL="sales@cashback.agency"

# Public base URL — builds the "View Request" links inside emails.
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# ─────────────────────────────────────────────────────────────
# CashBack Sales & Production Request — Railway (Node.js) + Supabase Storage
# Copy to ".env" (local) and set the same vars in Railway → your service →
# Variables for production. NEVER commit the real .env — server-only secrets.
# ─────────────────────────────────────────────────────────────

# ── Database: MongoDB Atlas (direct) ─────────────────────────
# Direct connection — Railway runs a normal Node.js runtime, so Prisma talks to
# Atlas directly (no Accelerate, no DIRECT_URL). Use the SRV string and include
# the isolated "/cashback_sales" DATABASE NAME before the "?".
# Atlas → Connect → Drivers → copy the mongodb+srv string, add the db name.
# Use a NEW password (see security note in DEPLOY-RAILWAY.md).
DATABASE_URL="mongodb+srv://<db-user>:<new-db-password>@<cluster>.rpmiysl.mongodb.net/cashback_sales?retryWrites=true&w=majority&appName=cashback-form"

# ── Supabase Storage + client (uploads/downloads) ────────────
SUPABASE_URL="https://<project-ref>.supabase.co"
# service_role key — Project Settings → API → service_role. SERVER ONLY. Never NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
# A NEW, dedicated PRIVATE bucket (create it in Supabase → Storage). See README.
SUPABASE_STORAGE_BUCKET="cashback-sales-refs"

# ── Auth (JWT session cookie) ────────────────────────────────
# Signs the Sales session JWT. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-secret"

# ── Seed Sales account (used by "npm run db:seed") ───────────
ADMIN_EMAIL="sales@cashback.agency"
ADMIN_PASSWORD="CashBack2026!"
ADMIN_NAME="CashBack Sales"

# ── Email: Resend (HTTP API) ─────────────────────────────────
# Leave RESEND_API_KEY blank to run in "dev mode": the notification is logged
# to the console and the app reports emailSent:false (no fake sends).
RESEND_API_KEY=""
RESEND_FROM="CashBack Production <onboarding@resend.dev>"
# Where NEW PRODUCTION REQUEST emails are delivered.
ADMIN_NOTIFICATION_EMAIL="sales@cashback.agency"

# Public base URL — builds the "View Request" links in emails.
# On Railway set this to your public service URL (https://<app>.up.railway.app).
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# PORT is provided automatically by Railway — do NOT set it yourself.
# `next start` binds to it; locally it defaults to 3000.

# ── Web Push (VAPID) — admin PWA push notifications ──────────
# Generate a pair: npx web-push generate-vapid-keys
# PUBLIC key goes in BOTH VAPID_PUBLIC_KEY and NEXT_PUBLIC_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY="<vapid-public-key>"
VAPID_PRIVATE_KEY="<vapid-private-key>"
VAPID_SUBJECT="mailto:sales@cashback.agency"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="<vapid-public-key>"
